{
  "name": "elm-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/setup-fonts.mjs && node scripts/sync-public.mjs && vite",
    "images:optimize": "node scripts/optimize-images.mjs",
    "fonts:subset-lineicons": "node scripts/subset-lineicons.mjs",
    "css:purge": "node scripts/purge-css.mjs",
    "build": "node scripts/setup-fonts.mjs && node scripts/build-search-index.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs && node scripts/generate-robots.mjs && node scripts/build-locales.mjs && pnpm sass && node scripts/purge-css.mjs && node scripts/optimize-images.mjs && node scripts/subset-lineicons.mjs && node scripts/sync-public.mjs && vite build && node scripts/copy-static.mjs",
    "wrap": "node scripts/wrap-partials.mjs",
    "fonts:setup": "node scripts/setup-fonts.mjs",
    "images:placeholders": "node scripts/fetch-placeholders.mjs",
    "images:sync-docs": "node scripts/sync-doc-images.mjs",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "locales:build": "node scripts/build-locales.mjs",
    "preview": "vite preview",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:1h": "node scripts/tunnel.mjs --timeout=1h",
    "sass": "sass src/scss/style.scss css/style.css --style=compressed --no-source-map --silence-deprecation=import",
    "deploy": "pnpm build && pnpm exec wrangler deploy",
    "deploy:ci": "pnpm exec wrangler deploy"
  },
  "dependencies": {
    "@fontsource/readex-pro": "^5.2.11",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tamagui/font-nohemi": "^2.3.2",
    "bootstrap": "4.5.0",
    "glob": "^11.0.2",
    "purgecss": "^8.0.0",
    "sass": "^1.89.0",
    "sharp": "^0.34.5",
    "subset-font": "^2.4.0",
    "vite": "^7.3.1",
    "vite-plugin-handlebars": "^2.0.0",
    "wrangler": "^4.34.0"
  }
}
